<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.wso2.carbon.extension.identity.authenticator.outbound.daon</groupId>
        <artifactId>identity-outbound-auth-daon</artifactId>
        <version>1.0.4-SNAPSHOT</version>
    </parent>

    <artifactId>org.wso2.carbon.extension.identity.authenticator.daon.connector</artifactId>
    <packaging>bundle</packaging>
    <name>WSO2 Carbon - Authenticator Library For Daon</name>
    <url>http://wso2.org</url>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>2.0</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Name>${project.artifactId}</Bundle-Name>
                        <Private-Package>org.wso2.carbon.identity.authenticator.daon.internal</Private-Package>
                        <Import-Package>
                            org.apache.commons.lang.*;resolution:=optional,
                            org.apache.commons.logging.*; version="1.0.4",
                            org.osgi.framework,
                            org.osgi.service.component.annotations.*; resolution:=optional,
                            org.wso2.carbon.identity.application.authentication.framework.*,
                            org.wso2.carbon.identity.application.authenticator.oidc.*,
                            org.wso2.carbon.identity.flow.execution.engine.*,
                            org.wso2.carbon.identity.core.util.*,
                            org.wso2.carbon.extension.identity.verification.mgt.*; resolution:=optional,
                            javax.servlet; version="${imp.pkg.version.javax.servlet}",
                            javax.servlet.http; version="${imp.pkg.version.javax.servlet}",
                            org.apache.oltu.oauth2.*; version="${oltu.package.import.version.range}",
                            org.json; version="${json.wso2.version.range}",
                        </Import-Package>
                        <Export-Package>
                            !org.wso2.carbon.identity.authenticator.daon.internal,
                            org.wso2.carbon.identity.authenticator.daon.*
                        </Export-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.scr.ds-annotations</artifactId>
            <version>${apache.felix.scr.ds.annotations.version}</version>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.flow.execution.engine</artifactId>
            <version>${carbon.identity.version}</version>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.extension.identity.verification</groupId>
            <artifactId>org.wso2.carbon.extension.identity.verification.mgt</artifactId>
            <version>${identity.verification.version}</version>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
        </dependency>
    </dependencies>
</project>
